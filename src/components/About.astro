---
import { site } from '../site.config';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang).about;
const focus = ['iOS', 'Backend', 'AI'];
const tools = ['Swift', 'Java', 'Quarkus'];
---
<section id="about" class="section">
  <div class="container wrap">
    <div class="code card reveal" aria-label={tr.cardTitle}>
      <div class="bar">
        <span class="dots"><i></i><i></i><i></i></span>
        <span class="file">Developer.swift</span>
      </div>
      <pre><code><span class="k">struct</span> <span class="ty">Developer</span> {'{'}
  <span class="k">let</span> name     = <span class="s">"{site.name}"</span>
  <span class="k">let</span> base     = <span class="s">"{site.location}"</span>
  <span class="k">let</span> school   = <span class="s">"HTBLA Leonding"</span>
  <span class="k">let</span> focus    = [{focus.map((f, i) => <><span class="s">"{f}"</span>{i < focus.length - 1 && ', '}</>)}]
  <span class="k">let</span> stack    = [{tools.map((f, i) => <><span class="s">"{f}"</span>{i < tools.length - 1 && ', '}</>)}]

  <span class="k">func</span> <span class="fn">currentWork</span>() -&gt; [<span class="ty">Role</span>] {'{'}
    [.<span class="fn">dev</span>(<span class="s">"SIXTOSIX"</span>), .<span class="fn">devMarketing</span>(<span class="s">"Neator AI"</span>)]
  {'}'}
{'}'}<span class="cursor"></span></code></pre>
    </div>
    <div class="text">
      <span class="label reveal">{tr.label}</span>
      <h2 class="section-title reveal" data-d="1">{tr.title}</h2>
      <p class="reveal" data-d="2">{tr.p1}</p>
      <p class="reveal" data-d="3">{tr.p2}</p>
      <dl class="facts">
        {tr.facts.map((f, i) => (
          <div class="fact card reveal" data-d={3 + i}>
            <dt>{f.k}</dt><dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 96px); align-items: center; }
  .code { position: relative; overflow: hidden; min-width: 0; }
  .code::before { content: ''; position: absolute; inset: -30% -30% auto auto; width: 70%; aspect-ratio: 1; background: radial-gradient(circle, rgb(91 140 255 / 0.18), transparent 65%); pointer-events: none; }
  .bar { display: flex; align-items: center; gap: 16px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .dots { display: flex; gap: 7px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--line-strong); }
  .dots i:first-child { background: #ff5f57; } .dots i:nth-child(2) { background: #febc2e; } .dots i:last-child { background: #28c840; }
  .file { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  pre { margin: 0; padding: clamp(20px, 3vw, 32px); overflow-x: auto; font-family: var(--font-mono); font-size: clamp(12px, 1.2vw, 14.5px); line-height: 1.85; color: var(--text); }
  .k { color: #c792ea; } .ty { color: var(--accent-2); } .s { color: var(--accent); } .fn { color: #ffcb6b; }
  .cursor { display: inline-block; width: 8px; height: 1.1em; margin-left: 4px; vertical-align: text-bottom; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .text p { margin-top: 24px; color: var(--muted); font-size: clamp(17px, 1.4vw, 19px); max-width: 56ch; }
  .facts { margin: 40px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .fact { padding: 18px 20px; border-radius: var(--radius-sm); }
  dt { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  dd { margin: 6px 0 0; font-weight: 600; }
  @media (max-width: 900px) {
    .wrap { grid-template-columns: 1fr; }
    .code { order: 2; }
  }
  @media (max-width: 480px) { .facts { grid-template-columns: 1fr; } }
</style>
