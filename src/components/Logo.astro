---
// HM-Monogramm als Vektor; Farbe folgt currentColor.
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
---
<svg class={className} width={size} height={Math.round(size * 465 / 564)} viewBox="343 393 564 465" fill="currentColor" aria-hidden="true">
  <polygon points="343,394 447,394 447,621 631,749 631,858 535,858 535,719 447,719 447,858 343,858" />
  <polygon points="476,526 615,621 907,393 907,858 804,858 804,590 634,718 476,608" />
</svg>
