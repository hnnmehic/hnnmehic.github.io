---
// HM-Digital-Signet (Knoten-Dreieck/Play) als Vektor; Linien folgen currentColor, der Punkt dem Akzent.
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
---
<svg class={className} width={Math.round(size * 432 / 486)} height={size} viewBox="520 390 432 486" fill="currentColor" aria-hidden="true">
  <circle cx="568" cy="438" r="48" />
  <circle cx="568" cy="827" r="48" />
  <g stroke="currentColor" stroke-width="44" stroke-linecap="round">
    <line x1="568" y1="516" x2="568" y2="749" />
    <line x1="635.5" y1="477" x2="835.5" y2="593" />
    <line x1="635.5" y1="788" x2="835.5" y2="672" />
  </g>
  <circle class="node" cx="903" cy="632.5" r="48" fill="var(--accent, #2ee58c)" />
</svg>
