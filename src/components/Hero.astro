---
import { site } from '../site.config';
import { t, type Lang } from '../i18n';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang).hero;
const { video, poster } = site.hero;
const hasVideo = Boolean(video.mp4 || video.webm);
const hasPhoto = Boolean(poster);
const [first, ...rest] = site.name.split(' ');
---
<section class:list={['hero', { 'has-photo': hasPhoto || hasVideo }]} aria-label={site.name}>
  <div class="media" aria-hidden="true">
    {hasVideo ? (
      <video class="bg" autoplay muted loop playsinline preload="metadata" poster={poster || undefined} data-hero-video>
        {video.webm && <source src={video.webm} type="video/webm" />}
        {video.mp4 && <source src={video.mp4} type="video/mp4" />}
      </video>
    ) : hasPhoto ? (
      <img class="bg" src={poster} alt="" fetchpriority="high" decoding="async" />
    ) : (
      <>
        <div class="glow"></div>
        <Logo class="sigil" size={640} />
      </>
    )}
    <div class="shade"></div>
    <div class="grid"></div>
  </div>

  <div class="container content">
    <p class="eyebrow reveal"><span class="dot"></span>{tr.eyebrow}</p>
    <h1 class="reveal" data-d="1">
      <span class="name">{first} <span class="thin">{rest.join(' ')}</span></span>
      <span class="claim">{tr.headlineA} <span class="accent">{tr.headlineB}</span></span>
    </h1>
    <p class="sub reveal" data-d="2">{tr.sub}</p>
    <div class="actions reveal" data-d="3">
      <a class="btn btn-primary" href="#projects">{tr.ctaProjects} <Icon name="arrow-down" size={18} /></a>
      <a class="btn btn-ghost" href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {tr.ctaContact}</a>
      <div class="socials">
        <a class="icon-btn" href={site.links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" /></a>
        <a class="icon-btn" href={site.links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" /></a>
      </div>
    </div>
  </div>

  <a href="#about" class="scroll" aria-label={tr.scroll}><span>{tr.scroll}</span><i></i></a>
</section>

<script>
  // Bei reduzierter Bewegung das Video anhalten und nur das Poster zeigen.
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); }
</script>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; isolation: isolate; }
  .media { position: absolute; inset: 0; z-index: -1; }
  .bg { width: 100%; height: 100%; object-fit: cover; object-position: 70% 30%; animation: zoom 18s var(--ease) both; }
  @keyframes zoom { from { transform: scale(1.08); filter: brightness(0.6); } to { transform: scale(1); filter: brightness(1); } }
  /* Großes Signet als Hintergrundmotiv; der grüne Knoten pulsiert leicht. */
  .media :global(.sigil) { position: absolute; right: max(5vw, calc(50% - 660px)); top: 50%; translate: 0 -50%; height: min(78vh, 720px); width: auto; overflow: visible; color: rgb(255 255 255 / 0.045); animation: rise 1.6s var(--ease) both; }
  .media :global(.sigil .node) { filter: drop-shadow(0 0 40px var(--accent)); animation: node 4s ease-in-out infinite; }
  .glow { position: absolute; width: 60vmax; height: 60vmax; right: -16vmax; top: 50%; translate: 0 -50%; background: radial-gradient(circle, rgb(46 229 140 / 0.12) 0%, transparent 60%); filter: blur(40px); }
  @keyframes rise { from { opacity: 0; transform: translateX(40px); } }
  @keyframes node { 50% { opacity: 0.55; } }
  .shade { position: absolute; inset: 0; background: linear-gradient(0deg, var(--bg) 0%, transparent 35%); }
  .has-photo .shade {
    background:
      linear-gradient(90deg, var(--bg) 0%, rgb(14 15 19 / 0.88) 32%, rgb(14 15 19 / 0.35) 62%, rgb(14 15 19 / 0.1) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 30%),
      linear-gradient(180deg, rgb(14 15 19 / 0.6) 0%, transparent 20%);
  }
  .grid {
    position: absolute; inset: 0; opacity: 0.35;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, #000 0%, transparent 80%);
  }
  .content { padding-block: 140px 120px; }
  .eyebrow { font-size: 13px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); display: inline-flex; align-items: center; gap: 12px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.35; } }
  h1 { margin-top: 28px; }
  .name { display: block; font-size: clamp(54px, 9vw, 124px); letter-spacing: -0.045em; line-height: 1; }
  .accent { color: var(--accent); }
  .claim { display: block; margin-top: 18px; font-size: clamp(24px, 3.2vw, 40px); font-weight: 500; color: var(--text); max-width: 22ch; letter-spacing: -0.01em; line-height: 1.15; }
  .sub { margin-top: 24px; max-width: 52ch; color: var(--muted); font-size: clamp(16px, 1.4vw, 18px); }
  .actions { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .socials { display: flex; gap: 10px; margin-left: 4px; }
  .scroll { position: absolute; left: 50%; bottom: 28px; translate: -50% 0; display: flex; flex-direction: column; align-items: center; gap: 10px; font-size: 11px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }
  .scroll i { width: 1px; height: 44px; background: linear-gradient(var(--accent), transparent); animation: drop 2s var(--ease) infinite; transform-origin: top; }
  @keyframes drop { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  @media (max-width: 820px) {
    .content { padding-block: 120px 96px; }
    .eyebrow { font-size: 11px; letter-spacing: 0.14em; }
    .scroll { display: none; }
    .media :global(.sigil) { height: 46vh; right: -10vw; top: 22%; color: rgb(255 255 255 / 0.035); }
    .media :global(.sigil .node) { opacity: 0.6; filter: none; animation: none; }
    .has-photo { align-items: flex-end; }
    .has-photo .media { bottom: auto; height: 68svh; }
    .has-photo .bg { object-position: 74% 30%; }
    .has-photo .shade { background: linear-gradient(0deg, var(--bg) 0%, rgb(14 15 19 / 0.7) 30%, transparent 60%, rgb(14 15 19 / 0.45) 100%); }
    .has-photo .grid { display: none; }
    .has-photo .content { padding-block: 52svh 72px; }
  }
</style>
