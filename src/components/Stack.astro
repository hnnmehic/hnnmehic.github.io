---
import { stack } from '../site.config';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang).stack;
const groups = Object.entries(tr.groups) as [keyof typeof tr.groups, string][];
---
<section id="stack" class="section">
  <div class="container">
    <span class="label reveal">{tr.label}</span>
    <h2 class="section-title reveal" data-d="1">{tr.title}</h2>
    <div class="bento">
      {groups.map(([key, title], i) => (
        <div class:list={['cell card reveal', key]} data-d={1 + i}>
          <span class="idx">0{i + 1}</span>
          <h3>{title}</h3>
          <ul>{stack.filter((s) => s.group === key).map((s) => <li>{s.name}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bento { margin-top: 56px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .cell { padding: 26px; display: flex; flex-direction: column; gap: 14px; min-height: 190px; }
  .cell { grid-column: span 3; }
  .devops { background: linear-gradient(140deg, rgb(91 140 255 / 0.12), var(--bg-2) 60%); }
  .ai { background: linear-gradient(140deg, rgb(94 242 193 / 0.12), var(--bg-2) 60%); }
  .idx { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  h3 { font-size: 22px; }
  ul { list-style: none; padding: 0; margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  li { font-size: 14px; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--line-strong); background: rgb(255 255 255 / 0.03); }
  @media (min-width: 1000px) {
    .mobile, .backend, .design { grid-column: span 2; }
  }
  @media (min-width: 641px) and (max-width: 999px) { .ai { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .bento > .cell { grid-column: 1 / -1; } .cell { min-height: 0; } }
</style>
