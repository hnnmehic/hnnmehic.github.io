---
import { getCollection } from 'astro:content';
import { t, type Lang } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang).projects;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<section id="projects" class="section">
  <div class="container">
    <span class="label reveal">{tr.label}</span>
    <h2 class="section-title reveal" data-d="1">{tr.title}</h2>
    <div class="grid">
      {projects.map(({ data: p }, i) => {
        const Tag = p.url ? 'a' : 'article';
        return (
          <Tag class="project card reveal" data-d={2 + i} {...(p.url ? { href: p.url, target: '_blank', rel: 'noopener noreferrer' } : {})}>
            <div class="top">
              {p.logo
                ? <img class="logo" src={p.logo} alt="" width="64" height="64" loading="lazy" />
                : <span class="logo mono" aria-hidden="true">{p.name.slice(0, 2)}</span>}
              <span class:list={['status', p.status]}><span class="dot"></span>{tr.statusLabel[p.status]}</span>
            </div>
            <h3>{p.name}</h3>
            <p class="tagline">{p.tagline[lang]}</p>
            <p class="role"><span>{tr.roleLabel}</span> {p.role[lang]}</p>
            <p class="desc">{p.description[lang]}</p>
            <ul class="tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
            {p.url && <span class="visit">{tr.visit} <Icon name="arrow" size={16} /></span>}
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  .grid { margin-top: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 20px; }
  .project { position: relative; padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; overflow: hidden; transition: border-color 0.4s, transform 0.5s var(--ease); }
  .project::after { content: ''; position: absolute; inset: auto -30% -60% auto; width: 70%; aspect-ratio: 1; background: radial-gradient(circle, var(--accent-glow), transparent 65%); opacity: 0; transition: opacity 0.5s; pointer-events: none; }
  .project:hover { border-color: var(--line-strong); transform: translateY(-4px); }
  .project:hover::after { opacity: 0.6; }
  .top { display: flex; align-items: center; justify-content: space-between; }
  .logo { width: 64px; height: 64px; border-radius: 16px; object-fit: cover; }
  .logo.mono { display: grid; place-items: center; font-family: var(--font-mono); font-weight: 600; color: #04110c; background: var(--gradient); }
  .status { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; }
  .status .dot { width: 7px; height: 7px; border-radius: 50%; background: #f5c35e; box-shadow: 0 0 10px #f5c35e; }
  .status.live .dot { background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .status.beta .dot { background: var(--accent-2); box-shadow: 0 0 10px var(--accent-2); }
  h3 { margin-top: 28px; font-size: clamp(28px, 3vw, 36px); }
  .tagline { margin-top: 6px; color: var(--accent); font-weight: 500; }
  .role { margin-top: 16px; font-family: var(--font-mono); font-size: 13px; color: var(--text); }
  .role span { color: var(--muted); }
  .role span::after { content: ':'; }
  .desc { margin-top: 16px; color: var(--muted); flex: 1; }
  .tags { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-family: var(--font-mono); font-size: 12px; padding: 5px 10px; border-radius: 6px; background: rgb(255 255 255 / 0.05); color: var(--text); }
  .visit { margin-top: 24px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--accent); }
</style>
